#!/usr/bin/env bash
# Runs Python from the skill's private environment (~/.faceless-shorts/venv), or runs setup if missing.
FH="${FACELESS_HOME:-$HOME/.faceless-shorts}"
SKILL="$(cd "$(dirname "$0")/.." && pwd)"

# Pre-flight check: auto-run setup if environment is missing
if [ ! -x "$FH/venv/bin/python" ] && [ ! -x "$FH/venv/Scripts/python.exe" ]; then
    echo "⚡ Setting up faceless-shorts private environment automatically..."
    bash "$SKILL/scripts/setup.sh"
fi

for p in "$FH/venv/bin/python" "$FH/venv/Scripts/python.exe"; do [ -x "$p" ] && exec "$p" "$@"; done
command -v python3 >/dev/null && python3 -c "" 2>/dev/null && exec python3 "$@"
exec python "$@"   # Windows (Git Bash)
