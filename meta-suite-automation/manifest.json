{
  "manifest_version": 3,
  "id": "meta-suite-automation",
  "name": "Meta Suite Page Management",
  "version": "2.1.1",
  "description": "Master Autonomous Meta Suite Production Engine (v2.1.1): Enterprise Meta Business Suite Facebook Page management, 6-Step Sequential Order Execution Rule, dual-mode native & local queue scheduler, custom Reel covers & video thumbnails, DeepX Google Flow AI bridge, anti-ad organic shield, and 2M-20M viral recommendation algorithms.",
  "author": "Dipesh Kr Yadav",
  "icon": "icon.png",
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "tabs",
    "scripting",
    "debugger",
    "cookies",
    "storage",
    "alarms",
    "downloads",
    "antigemFiles"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.business.facebook.com/*",
    "*://*.instagram.com/*",
    "*://*.flow.google.com/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "worker": "worker.js",
  "mcp_tools": [
    {
      "name": "fb_status",
      "description": "Check Meta Suite and Facebook Automation status, verify bridge connectivity, and active login session.\nMANDATORY LITERAL FIRST TOOL CALL on any Meta Suite or Facebook task (<100ms).\nReturns ready status, logged_in state, active accounts, discovered pages, and queued jobs.",
      "inputSchema": {
        "properties": {
          "open_browser": {
            "default": true,
            "title": "Open Browser",
            "type": "boolean"
          }
        },
        "title": "fb_statusArguments",
        "type": "object"
      }
    },
    {
      "name": "fb_login_status",
      "description": "\n    Open Facebook (https://www.facebook.com/) in the browser if not already open,\n    detect current active login session, and persist one-time login state.\n    IMPORTANT: If logged_in is false, tell the user once to sign in inside the open browser tab and STOP immediately.\n    ",
      "inputSchema": {
        "properties": {
          "open_browser": {
            "default": true,
            "title": "Open Browser",
            "type": "boolean"
          }
        },
        "title": "fb_login_statusArguments",
        "type": "object"
      }
    },
    {
      "name": "fb_open_browser",
      "description": "\n    Explicitly open and focus Facebook in the browser (feed, reels, stories, page, or business_suite)\n    and check one-time login readiness.\n    ",
      "inputSchema": {
        "properties": {
          "target_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Target Id"
          },
          "view": {
            "default": "feed",
            "title": "View",
            "type": "string"
          }
        },
        "title": "fb_open_browserArguments",
        "type": "object"
      }
    },
    {
      "name": "fb_publish",
      "description": "\n    ONE-TOUCH META BUSINESS SUITE PAGE PUBLISHER (Page Posts, Photos, Carousels, Videos, Reels, Stories):\n    Dedicated strictly to Facebook Page Management via Meta Business Suite (business.facebook.com).\n    MANDATORY RULES:\n    1. ZERO OVERTHINKING: Call `fb_publish`, `fb_publish_reel`, or `fb_publish_story` directly as your FIRST tool call.\n    2. UNIFIED PHOTO + DEEP QUOTE: Pass `media_paths=[\"latest\"]` (or user file path), `title`, formatted multiline `caption` (Title -> blank line -> Quote -> Bullets -> CTA), and 3-6 `hashtags`.\n    3. FORMATTED CAPTION & HASHTAGS: Keep `\n\n` spacing between Title, Description, CTA, and `#Hashtags`.\n    4. CUSTOM VIDEO THUMBNAIL: When uploading Page Videos with `thumbnail_path`, passes `thumbnail_path` to Edit Video -> Thumbnail panel.\n    5. ORGANIC SHIELD: Strictly ensures 'Make this an ad post' is OFF.\n    ",
      "inputSchema": {
        "properties": {
          "caption": {
            "default": "",
            "title": "Caption",
            "type": "string"
          },
          "first_comment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "First Comment"
          },
          "hashtags": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Hashtags"
          },
          "media_paths": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Media Paths"
          },
          "post_type": {
            "default": "text",
            "title": "Post Type",
            "type": "string"
          },
          "story_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Story Text"
          },
          "target_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "me",
            "title": "Target Id"
          },
          "target_type": {
            "default": "page",
            "title": "Target Type",
            "type": "string"
          },
          "thumbnail_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Thumbnail Path"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Title"
          }
        },
        "title": "fb_publishArguments",
        "type": "object"
      }
    },
    {
      "name": "fb_publish_reel",
      "description": "\n    DEDICATED META BUSINESS SUITE PAGE REELS PUBLISHER:\n    Uploads a vertical 9:16 video as a Facebook Page Reel in Meta Business Suite:\n    - Custom Cover / Thumbnail (`thumbnail_path`): automatically uploaded in Reel Cover panel.\n    - Viral `title` + formatted multiline `caption` (`\n\n` spacing preserved) + 3-6 `#Hashtags`.\n    - Supports `video_path=\"latest\"` to pick the newest vertical video automatically.\n    ",
      "inputSchema": {
        "properties": {
          "caption": {
            "default": "",
            "title": "Caption",
            "type": "string"
          },
          "hashtags": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Hashtags"
          },
          "target_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "me",
            "title": "Target Id"
          },
          "target_type": {
            "default": "page",
            "title": "Target Type",
            "type": "string"
          },
          "thumbnail_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
