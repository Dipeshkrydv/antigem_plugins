    {
      "name": "fb_schedule",
      "description": "\n    Schedule a Facebook Page post, reel, or story for future publication in Meta Business Suite.\n    Enqueues the job into the SQLite APScheduler queue (or native Meta Business Suite scheduler).\n    Accepts either `schedule_time_iso` (e.g. '2026-11-19T10:00:00Z') or `run_at_timestamp` (epoch float).\n    Always enforces a viral Title (`title`), formatted multiline Description, and 3-6 `#Hashtags` (`hashtags`) for posts/videos/reels, or clean `story_text` for Stories.\n    ",
      "inputSchema": {
        "properties": {
          "caption": {
            "default": "",
            "title": "Caption",
            "type": "string"
          },
          "hashtags": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Hashtags"
          },
          "media_paths": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Media Paths"
          },
          "post_type": {
            "default": "text",
            "title": "Post Type",
            "type": "string"
          },
          "run_at_timestamp": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Run At Timestamp"
          },
          "schedule_time_iso": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Schedule Time Iso"
          },
          "story_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Story Text"
          },
          "target_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "me",
            "title": "Target Id"
          },
          "target_type": {
            "default": "page",
            "title": "Target Type",
            "type": "string"
          },
          "thumbnail_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Thumbnail Path"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Title"
          },
          "use_native_meta_scheduler": {
            "default": true,
            "title": "Use Native Meta Scheduler",
            "type": "boolean"
          }
        },
        "title": "fb_scheduleArguments",
        "type": "object"
      }
