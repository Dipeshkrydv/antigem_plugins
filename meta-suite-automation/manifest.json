    {
      "name": "fb_manage_queue",
      "description": "Controls and inspects the local SQLite APScheduler post queue for Meta Business Suite & Facebook:\n- action=\"list\": Lists upcoming and pending scheduled posts.\n- action=\"cancel\": Cancels a scheduled job by job_id.\n- action=\"reschedule\": Changes scheduled time for job_id to new_schedule_time_iso.\n- action=\"pause_all\": Emergency pauses all upcoming jobs in queue.\n- action=\"resume_all\": Resumes paused jobs in queue.",
      "inputSchema": {
        "properties": {
          "action": {
            "default": "list",
            "description": "Action to perform: 'list', 'cancel', 'reschedule', 'pause_all', or 'resume_all'",
            "title": "Action",
            "type": "string"
          },
          "job_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Scheduled job ID to cancel or reschedule",
            "title": "Job Id"
          },
          "limit": {
            "default": 20,
            "description": "Maximum number of queued jobs to return for list action",
            "title": "Limit",
            "type": "integer"
          },
          "new_schedule_time_iso": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Target UTC ISO timestamp for rescheduling (e.g. '2026-11-19T14:30:00Z')",
            "title": "New Schedule Time Iso"
          }
        },
        "title": "fb_manage_queueArguments",
        "type": "object"
      }
    },
